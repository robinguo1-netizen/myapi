# Runtime
PORT=8080
GIN_MODE=release
TZ=Asia/Shanghai
NODE_TYPE=master
NODE_NAME=superapi

# PostgreSQL (inject from Secret Manager; require sslmode=require or stronger)
SQL_DSN=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/DATABASE?sslmode=require

# Session security (inject the secret from Secret Manager)
SESSION_SECRET=REPLACE_WITH_SECRET_MANAGER_REFERENCE
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://REPLACE_WITH_FINAL_HTTPS_HOST
TRUSTED_PROXIES=REPLACE_WITH_VERIFIED_PROXY_RANGES

# Optional Redis. Do not expose Redis publicly.
REDIS_CONN_STRING=redis://:PASSWORD@PRIVATE_REDIS_HOST:6379/0
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60

# Relay and Cloud Run request lifetime must be aligned.
RELAY_TIMEOUT=300
STREAMING_TIMEOUT=240
SHUTDOWN_TIMEOUT_SECONDS=8
BATCH_UPDATE_ENABLED=false

# Conservative initial limits; tune from measured traffic.
GLOBAL_API_RATE_LIMIT=180
GLOBAL_WEB_RATE_LIMIT=120
SQL_MAX_IDLE_CONNS=10
SQL_MAX_OPEN_CONNS=30
SQL_MAX_LIFETIME=300

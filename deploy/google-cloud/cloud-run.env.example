# Reference only; deploy.py supplies these values with explicit Cloud Run flags.
# Do not put PORT in --set-env-vars: Cloud Run owns PORT (use --port=8080).
GIN_MODE=release
TZ=UTC
NODE_TYPE=master
NODE_NAME=superapi

# Inject SQL_DSN and SESSION_SECRET via --set-secrets with pinned version numbers.
# Never copy real credentials into this file.
# The postgres:// or postgresql:// scheme is required by model/main.go.
# Unix socket template (sslmode=disable is ONLY for the local Auth Proxy socket;
# Cloud SQL Auth Proxy handles encryption and IAM to the remote database):
# SQL_DSN=postgresql://rs_app:ENCODED_PASSWORD@/rs_api?host=%2Fcloudsql%2FPROJECT%3Aeurope-west1%3Asuperapi-test-pg&sslmode=disable
# SESSION_SECRET=<Secret Manager version, not a literal environment variable>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://REPLACE_WITH_EXACT_CLOUD_RUN_HTTPS_ORIGIN

# Safe initial behavior: ignore spoofable forwarded IPs; 2-3 testers share limits.
# Do not replace with '*' or 0.0.0.0/0. Evaluate Cloud Run proxy behavior before tuning.
TRUSTED_PROXIES=none

# No Redis in this single-instance functional-test profile.
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60
RELAY_TIMEOUT=300
STREAMING_TIMEOUT=240
SHUTDOWN_TIMEOUT_SECONDS=8
BATCH_UPDATE_ENABLED=false
GLOBAL_API_RATE_LIMIT=180
GLOBAL_WEB_RATE_LIMIT=120
SQL_MAX_IDLE_CONNS=2
SQL_MAX_OPEN_CONNS=10
SQL_MAX_LIFETIME=300

# No registration environment variable exists: bootstrap persists both options
# RegisterEnabled=false and PasswordRegisterEnabled=false via the root API.
